<grit latest_public_release="0" current_release="1" output_all_resource_defines="false">
  <outputs>
    <output filename="grit/gemini_chat_resources.h" type="rc_header">
      <emit emit_type='prepend'></emit>
    </output>
    <output filename="grit/gemini_chat_resources_map.cc" type="resource_file_map_source" />
    <output filename="grit/gemini_chat_resources_map.h" type="resource_map_header" />
    <output filename="gemini_chat_resources.pak" type="data_package" />
  </outputs>
  <release seq="1">
    <includes>
      <include name="IDR_GEMINI_CHAT_GEMINI_CHAT_HTML" file="gemini_chat.html" type="BINDATA" />
      <include name="IDR_GEMINI_CHAT_GEMINI_CHAT_CSS" file="gemini_chat.css" type="BINDATA" />
      <include name="IDR_GEMINI_CHAT_GEMINI_CHAT_JS" file="gemini_chat.js" type="BINDATA" />
    </includes>
  </release>
</grit>
